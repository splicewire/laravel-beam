/**
 * The READ projection for the `{{ key }}` particle resource, and its declaration site.
 *
 * The resource's two shapes are declared HERE, before any behaviour exists, because a surface whose shape is
 * undeclared is negative space to `splicewire:beam:undeclared-surface` no matter how correct its behaviour is:
 * the read projection is THIS class (`data:` is omitted because omitting it names the annotated class), and
 * `input:` is the write shape, {{ inputNote }}. Filling in the properties is the next step; deleting a slot is not.
 *
 * The attribute DECLARES; the host ROUTES. Mount it from a route file:
 *
 *     Particle::mount('{{ uri }}', '{{ key }}');
 *
 * The closures an attribute cannot carry are resolved by CONVENTION from `public static` methods on THIS
 * class, each optional — add them when you need them:
 *
 *     public static function scope(\Illuminate\Database\Eloquent\Builder $q): \Illuminate\Database\Eloquent\Builder
 *     public static function publicScope(\Illuminate\Database\Eloquent\Builder $q): \Illuminate\Database\Eloquent\Builder  // ADR-0230: a guest's rows on top of scope()
 *     public static function project({{ model }} $model): \Spatie\LaravelData\Data
 *     public static function prepare({{ model }} $model, mixed $input, mixed $actor): void
 *     public static function afterWrite({{ model }} $model, mixed $input): void
 */
#[ParticleResource(
    key: '{{ key }}',
    backing: {{ model }}::class,
    input: {{ inputSlot }},
    readOnly: {{ readOnly }},
{{ sectionLine }}    // ADR-0230 Public Read — declared EXPLICITLY, never silent. A guest (a null actor) is refused on every
    // read path UNLESS this names the Data class a guest may read: `{{ class }}::class` when every field it
    // projects is public, or a narrower Data class. Leave `null` for an authenticated-only resource — do not
    // delete the slot: `splicewire:beam:doctor` counts a guest-reachable resource that declares none.
    publicRead: {{ publicRead }},
)]
class {{ class }} extends Data
{

<?php

namespace {{ namespace }};

use Spatie\LaravelData\Data;

/**
 * The WRITE DTO for the `{{ key }}` particle resource — the `input:` slot of {{ readClass }}.
 *
 * `toModelAttributes()` is the app convention `ParticleController` looks for: it maps the parsed input onto
 * model columns. Absent this class the controller falls back to a snake-case map of whatever arrived, which
 * is a shape nobody declared — that fallback is what this class exists to replace.
 */
class {{ class }} extends Data
{
    public function __construct(
        // Replace with the fields this resource accepts on store/update.
        public ?string $name = null,
    ) {}

    /**
     * The write map: DTO field ⇒ model column.
     *
     * @return array<string, mixed>
     */
    public function toModelAttributes(): array
    {
        return [
            'name' => $this->name,
        ];
    }
}

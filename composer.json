{
    "name": "splicewire/laravel-beam",
    "description": "The schema-driven-CMS core: composes the open schema foundation (schemastud/laravel-data-schemas + schemastud/laravel-frame) and the open versioning foundation (rushing/laravel-versioning) into a schema-typed, snapshot-versioned, migrate-on-read BeamParticle. Depends DOWN on the open foundations (the ADR-0092 direction, paid→open); per ADR-0156 that now includes schemastud/laravel-frame — the agnostic resource-scaffolding rung — so beam natively implements Frame's FrameResourceHandler port (chain: splicewire/beam → schemastud/frame → schemastud/data-schemas, monotonic, no cycle). Also the runtime home of the host-hook registries (webhook / sitemap / doctor), the realm registry, and the particle resource declarations. The media arm (medialibrary + the media model traits + media table) was extracted DOWN into splicewire/laravel-beam-media (HTTP-03 / ADR-0178); base beam no longer requires medialibrary and does NOT require beam-media (no cycle). Headless = no editor SURFACE running; Frame's scaffolding may be present-but-inert. No Beam model is minted; beam is a substrate, not an instance.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "nette/php-generator": "^3.4|^4.0",
        "rushing/codegen": "dev-main",
        "rushing/laravel-data-filters": "*",
        "rushing/laravel-data-schemas-scribe": "*",
        "rushing/laravel-doctor": "*",
        "rushing/laravel-permission-cascade": "*",
        "rushing/laravel-popcorn": "dev-main",
        "rushing/laravel-versioning": "dev-main",
        "schemastud/laravel-data-schemas": "^1.0",
        "schemastud/laravel-frame": "dev-main",
        "schemastud/laravel-json-ns": "dev-main",
        "spatie/laravel-activitylog": "^4.0|^5.0",
        "spatie/laravel-data": "^4.0|^5.0",
        "spatie/laravel-model-flags": "*",
        "spatie/laravel-model-status": "*",
        "spatie/laravel-package-tools": "^1.16",
        "spatie/laravel-schemaless-attributes": "*",
        "spatie/laravel-sluggable": "^3.5|^4.0",
        "spatie/typescript-transformer": "^2.0|^3.0",
        "symfony/yaml": "^6.0|^7.0|^8.0",
        "rushing/laravel-schema-convergence": "*"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0",
        "rushing/laravel-surgeon": "*",
        "rushing/php-package-topology": "dev-main",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Splicewire\\Beam\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Splicewire\\Beam\\Tests\\": "tests/"
        }
    },
    "extra": {
        "package-topology": {
            "because": "beam depends DOWN on frame (direction corrected — see tower refactor); the vendor-seam policy lives on the base package. beam also depends DOWN on schemastud/laravel-json-ns (ADR-0191): SchemaId extends the one fleet-wide NamespaceUri parser, and the Laravel binding tier is where beam binds json-ns ports (VocabularyRegistry, ADR-0192) into the container — the splicewire/* → schemastud/* direction R1 sanctions",
            "mustRequire": [
                "schemastud/laravel-frame",
                "schemastud/laravel-json-ns"
            ],
            "mustRequireDev": [
                "rushing/laravel-surgeon"
            ],
            "policy": {
                "noRequire": [
                    {
                        "fromPrefix": "schemastud/",
                        "toPrefix": "splicewire/",
                        "because": "R1 (ADR-0156): the open foundation (schemastud/*) never requires splicewire/* — the frame→beam exception was removed when the arrow inverted to beam→frame"
                    },
                    {
                        "fromPrefix": "splicewire/laravel-beam",
                        "toPrefix": "splicewire/laravel-satellite",
                        "because": "R2: a beam package never requires a satellite"
                    },
                    {
                        "fromPrefix": "splicewire/laravel-beam",
                        "toPrefix": "splicewire/tower",
                        "because": "R3 (marketplace build, Seam 1): a beam package never requires the composed Tower host tier — laravel-beam-market in particular must stay entirely blind to Tower's world, the same DOWN-only direction R2 already holds for satellite"
                    }
                ]
            }
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "laravel": {
            "providers": [
                "Splicewire\\Beam\\BeamServiceProvider"
            ]
        },
        "merge-plugin": {
            "include": [
                "composer.local.json"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "pint": "@php -d memory_limit=512M vendor/bin/pint",
        "test": "@php vendor/bin/phpunit"
    },
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/stephenr85/codegen.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-data-filters.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-data-schemas-scribe.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-doctor.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-permission-cascade.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-popcorn.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-schema-convergence.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-surgeon.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-versioning.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/php-package-topology.git"
        },
        {
            "type": "git",
            "url": "https://github.com/schemastud/laravel-data-schemas.git"
        },
        {
            "type": "git",
            "url": "https://github.com/schemastud/laravel-frame.git"
        },
        {
            "type": "git",
            "url": "https://github.com/schemastud/laravel-json-ns.git"
        }
    ]
}
